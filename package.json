{
  "name": "gscli",
  "version": "0.1.0",
  "description": "Google Search CLI — extract SERP links via agent-browser/CDP with human typing simulation, AI Mode, history, cache and merge.",
  "type": "module",
  "bin": {
    "gscli": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
